# ============================================================================
# inggrisin engine — contoh environment untuk menjalankan LANGSUNG (lokal)
# ----------------------------------------------------------------------------
# Di produksi nilai-nilai ini TIDAK pernah diisi manual: workflow
# .github/workflows/inggrisin.yml memetakan `inputs` dispatch → env, dan
# secret datang dari repository secrets (GROQ_API_KEY, OPENROUTER_API_KEY).
#
# File ini untuk development engine di mesinmu:
#     set -a; source env.example; set +a     # lalu isi nilai asli
#     python -m engine.main --workspace work --out out --report out/report.json
#
# Butuh lokal: Python 3.11, ffmpeg+ffprobe di PATH, dan (untuk TTS nyata)
# jaringan untuk mengunduh model Piper (~60 MB, di-cache di PIPERS_VOICE_DIR).
# ============================================================================

# --- identitas job -----------------------------------------------------------
INGGRISIN_JOB_ID=job_local00000001
INGGRISIN_IDEMPOTENCY_KEY=idem-local-0001
INGGRISIN_CONTRACT_VERSION=2026-10-15.1
INGGRISIN_ENGINE_VERSION=2026-10-15.1

# --- MODE: first | revision --------------------------------------------------
# first    = pipeline penuh (Whisper + LLM + TTS + render)
# revision = SRT pass-through: TANPA Groq/OpenRouter; butuh REVISIONS_URL dll.
INGGRISIN_MODE=first
# INGGRISIN_REVISION_NUMBER=1
# INGGRISIN_REVISIONS_URL=https://<app>/api/jobs/<job_id>/revisions/1?token=<sekali-pakai>
# INGGRISIN_RESULT_DRIVE_FILE_ID=<file id video (EN) yang akan ditimpa>

# --- sumber video ------------------------------------------------------------
# URL apa pun yang bisa di-GET. Untuk file lokal, serve dulu:
#     python -m http.server 8899 --directory /path/ke/folder
# lalu isi http://127.0.0.1:8899/video.mp4
INGGRISIN_SOURCE_URL=http://127.0.0.1:8899/contoh.mp4
INGGRISIN_SOURCE_NAME=contoh.mp4
INGGRISIN_SOURCE_BYTES=0
# INGGRISIN_SOURCE_SHA256=

# --- callback (hasil) ---------------------------------------------------------
# Lokal boleh menunjuk server palsu (mis. `nc -l 9999`) atau app dev-mu:
# POST akan datang dengan header x-inggrisin-signature: sha256=<hmac>
INGGRISIN_CALLBACK_URL=http://127.0.0.1:5173/api/hooks/v1/jobs/job_local00000001
INGGRISIN_CALLBACK_SECRET=secret-minimal-32-karakter-aaaaaaaaaaaaaaaa

# --- keluaran Drive -----------------------------------------------------------
# Lokal: nilai bebas (upload via proxy tidak tersedia di luar Workers;
# biarkan INGGRISIN_RESULT_UPLOAD_URL kosong dan siapkan GOOGLE_ACCESS_TOKEN
# JIKA mau uji jalur direct — untuk dev cukup biarkan gagal di tahap upload
# dan periksa out/<dubbed>.mp4 + out/report.json).
INGGRISIN_DRIVE_FOLDER_ID=folder-lokal
INGGRISIN_DUBBED_FILE_NAME=contoh (EN).mp4
# INGGRISIN_RESULT_UPLOAD_URL=

# --- BYOK (WAJIB hanya untuk mode first) --------------------------------------
GROQ_API_KEY=gsk_xxx
OPENROUTER_API_KEY=sk-or-v1-xxx
# INGGRISIN_OPENROUTER_API_KEY=          # alias alternatif

# --- model & suara (keputusan sistem; JANGAN ubah sembarangan) ----------------
INGGRISIN_WHISPER_MODEL=whisper-large-v3-turbo
INGGRISIN_LLM_MODEL=openai/gpt-4o-mini
INGGRISIN_VOICE=en_US-lessac-medium
# Konstanta kontrak TERKUNCI — engine MENOLAK nilai lain (contract_mismatch):
INGGRISIN_OPTIONS={"fit_mode":"blur","timing":"strict","tempo_max":1.25,"subtitles":"burn","music":false,"subtitle_bottom_pct":19}

# --- runtime -------------------------------------------------------------------
# Direktori cache model Piper (default ~/.piper-voices)
# PIPERS_VOICE_DIR=
# GITHUB_RUN_ID / GITHUB_RUN_URL hanya diisi GitHub Actions:
# GITHUB_RUN_ID=
# GITHUB_RUN_URL=
